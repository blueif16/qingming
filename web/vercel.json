{
  "routes": [
    {
      "src": "^/assets/[^/]+-[A-Za-z0-9_-]{8}\\.(?:js|css|wasm)$",
      "headers": { "Cache-Control": "public, max-age=31536000, immutable" },
      "continue": true
    },
    {
      "src": "^/assets/tex/[^/]+\\.[0-9a-f]{8}\\.(?:webp|ktx2)$",
      "headers": { "Cache-Control": "public, max-age=31536000, immutable" },
      "continue": true
    }
  ]
}
