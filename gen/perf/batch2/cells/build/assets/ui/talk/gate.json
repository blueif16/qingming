{"about":"Built by tools/ui_data.mjs (tools/talk_data.mjs) from sections/*/talk.json; do not edit.","section":"gate","scenes":[{"id":"V5.1","section":"gate","title":"貨到稅訖","titleEn":"Goods Arrive, Tax Paid","host":"inspector","roles":{"inspector":{"fig":"tax_inspector","name":"稅吏","nameEn":"tax inspector","carriedBy":null},"official":{"fig":"tax_official","name":"稅官","nameEn":"tax official","carriedBy":null},"owner":{"fig":"tax_carter_manifest","name":"貨主","nameEn":"goods owner","carriedBy":null},"gaper":{"fig":"tax_carter_gaping_6300","name":"車夫","nameEn":"carter","carriedBy":null},"watchman":{"fig":"tower_watchman","name":"更夫","nameEn":"watchman","carriedBy":null},"declarer":{"fig":"tax_declarer","name":"車夫","nameEn":"carter","carriedBy":null},"clerk":{"fig":"tax_clerk_seated_6340","name":"書吏","nameEn":"clerk","carriedBy":null}},"beats":[{"who":"inspector","text":"你的貨也在這裏？","en":"Are your goods here too?","think":false,"optional":false,"as":{"guan":"官人可是來查稅的？","shi":"相公是讀書人，也有貨麼？","seng":"師父化緣化到稅務來了？","fu":"娘子的貨，也得報上來。","tong":"小娃兒，莫在貨包上爬。","jun":"軍爺押酒的？鋪屋在西頭。","li":"你的貨也在這裏？貨單呢？"},"asEn":{"guan":"Sir, have you come to check the tax?","shi":"A scholar, sir? Goods to declare too?","seng":"Master, begging alms at the tax office?","fu":"Madam, your goods must be declared too.","tong":"Kid, don't climb on the bales.","jun":"Escorting wine, soldier? The post is to the west.","li":"Yours here too? Where's the manifest?"}},{"who":"inspector","text":"匹帛稅重，照例該納這個數。","en":"Silk and cloth pay heavy. By the rule, this much.","think":false,"optional":false},{"who":"owner","text":"官人看貨單，一包一包都寫著。","en":"See the manifest, sir. Every bale is written down.","think":false,"optional":false},{"who":"gaper","text":"啊——？這麼多！","en":"What? That much!","think":false,"optional":false},{"who":"official","text":"引子拿來。沒有引子，照重稅算。","en":"Your permit. Without one, it's the heavy rate.","think":false,"optional":false},{"who":"watchman","text":"底下吵甚麼？","en":"What's the row down there?","think":true,"optional":true}],"again":[{"beats":[{"who":"inspector","text":"又來了？貨過城門，先納過稅。","en":"Back again? Goods through the gate pay transit tax first.","think":false,"optional":false,"as":{"guan":"官人又來了，稅簿在此。","li":"又是你？貨過城門要納稅。"},"asEn":{"guan":"Back again, sir. Here is the tax book.","li":"You again? Goods through the gate pay tax."}},{"who":"owner","text":"過稅之外，還要住稅？","en":"Transit tax, and sales tax on top?","think":false,"optional":false},{"who":"inspector","text":"車也要納力勝錢。","en":"And the cart pays its load tax.","think":false,"optional":false},{"who":"gaper","text":"這一趟，白跑了。","en":"This whole trip, for nothing.","think":false,"optional":false},{"who":"official","text":"莫吵，一筆一筆都記上。","en":"No shouting. Every sum goes in the book.","think":false,"optional":false}]},{"beats":[{"who":"declarer","text":"引子在此，請官人過目。","en":"Here is my permit, sir. Please look.","think":false,"optional":false},{"who":"official","text":"品名數目，和貨對得上。","en":"Kind and count match the goods.","think":false,"optional":false},{"who":"inspector","text":"那桿大秤，專稱重貨。","en":"That big scale is for weighing heavy goods.","think":false,"optional":false},{"who":"clerk","text":"記上了。下一個。","en":"Written down. Next.","think":false,"optional":false},{"who":"inspector","text":"匹帛最重，向來如此。","en":"Cloth pays the most. Always has.","think":true,"optional":false}]}],"step":"tax.1","X":-36.23,"D":10.67},{"id":"V5.2","section":"gate","title":"禁軍運酒","titleEn":"The Guards' Wine","host":"wrist","roles":{"wrist":{"fig":"archer_wrist_5728","name":"弓手","nameEn":"archer","carriedBy":null},"drawer":{"fig":"archer_drawing_bow_5635","name":"弓手","nameEn":"archer","carriedBy":null}},"beats":[{"who":"wrist","text":"站遠些，這裏押著酒。","en":"Stand back. We're guarding wine here.","think":false,"optional":false,"as":{"guan":"官人，這幾桶是禁軍的酒。","shi":"相公，這酒不賣。","seng":"師父，酒是戒的，莫看了。","fu":"娘子，這是軍鋪，請回。","tong":"小娃兒，莫碰酒桶！","jun":"兄弟也是來押酒的？","li":"你是來拉酒的？不是就走。"},"asEn":{"guan":"Sir, these casks are the Guards' wine.","shi":"Sir, this wine isn't for sale.","seng":"Master, wine is forbidden you. Don't look.","fu":"Madam, this is a military post. Please go.","tong":"Kid, hands off the casks!","jun":"Brother, here to escort wine too?","li":"Here to haul the wine? If not, move on."}},{"who":"drawer","text":"好弓！拉得滿滿的。","en":"Good bow! It draws right full.","think":false,"optional":false},{"who":"wrist","text":"車子怎地還不來？","en":"Why isn't the cart here yet?","think":false,"optional":false},{"who":"drawer","text":"押了這趟酒，節下也分幾碗。","en":"Escort this lot, and we get a few bowls for the holiday.","think":false,"optional":false},{"who":"drawer","text":"方才那碗，力氣都上來了。","en":"That bowl just now: I'm full of strength.","think":true,"optional":false}],"again":[{"beats":[{"who":"wrist","text":"這本是軍巡鋪，防火的。","en":"This was a fire-watch post.","think":false,"optional":false},{"who":"drawer","text":"水桶如今裝了酒，倒也合用。","en":"The water butts hold wine now. They serve.","think":false,"optional":false},{"who":"wrist","text":"麻搭也閒著，沒纏麻。","en":"The fire swab lies idle, no hemp on it.","think":false,"optional":false},{"who":"drawer","text":"等車來拉，送進營裏。","en":"We wait for the cart, then it's off to camp.","think":false,"optional":false}],"step":"wine.2"},{"beats":[{"who":"drawer","text":"路上怕人劫酒，弓得拉得開。","en":"Robbers might take the wine. The bow must draw.","think":false,"optional":false},{"who":"wrist","text":"護腕綁緊了，才好開弓。","en":"Bind the wrist tight, then you can draw.","think":false,"optional":false},{"who":"drawer","text":"城門沒人守，倒來守酒。","en":"No one guards the gate, but we guard wine.","think":true,"optional":false}]}],"X":-43.01,"D":13.6},{"id":"V5.3","section":"gate","title":"糧也納稅","titleEn":"Grain Pays Too","host":"bag","roles":{"bag":{"fig":"man_with_bag_5892","name":"貨主","nameEn":"goods owner","carriedBy":null},"pack":{"fig":"pack_handler_5837","name":"腳夫","nameEn":"porter","carriedBy":null},"pusher":{"fig":"cart_pusher_5727","name":"車夫","nameEn":"carter","carriedBy":null}},"beats":[{"who":"bag","text":"前頭還吵著？咱的稅也得納。","en":"Still arguing up front? We've tax to pay too.","think":false,"optional":false,"as":{"guan":"官人，糧也要納稅麼？","fu":"娘子讓讓，驢子踢人。","tong":"小哥兒，離驢屁股遠些。","li":"兄弟，搭把手卸了這馱。"},"asEn":{"guan":"Sir, does grain pay tax too?","fu":"Mind, madam, the donkey kicks.","tong":"Little one, keep clear of the donkey's rump.","li":"Brother, lend a hand with this pack."}},{"who":"pack","text":"這馱糧，送去正店釀酒。","en":"This grain goes to the wine house for brewing.","think":false,"optional":false},{"who":"bag","text":"稅錢都在這裏，點清了再走。","en":"The tax money's all here. Count it, then we go.","think":false,"optional":false},{"who":"pusher","text":"再推一把，正店就在前頭。","en":"One more push. The wine house is just ahead.","think":false,"optional":false}],"again":[{"beats":[{"who":"bag","text":"糧也得納稅，一文不少。","en":"Grain pays tax too, to the last cash.","think":false,"optional":false},{"who":"pack","text":"這糧是船上卸下來的。","en":"This grain came off the boats.","think":false,"optional":false},{"who":"bag","text":"正店官許釀酒，糧都賣給它。","en":"The wine house may brew by licence. The grain goes there.","think":false,"optional":false},{"who":"pusher","text":"到了門前，還得卸。","en":"At its door we still have to unload.","think":false,"optional":false}],"step":"grain.4"},{"beats":[{"who":"bag","text":"京裏正店七十二戶，家家要糧。","en":"The capital has seventy-two wine houses. All want grain.","think":false,"optional":false},{"who":"pack","text":"這驢今日馱得夠了。","en":"This donkey has carried enough today.","think":true,"optional":false},{"who":"pusher","text":"莫說了，推車！","en":"Enough talk. Push!","think":false,"optional":false}]}],"X":-39.08,"D":11.22},{"id":"V5.4","section":"gate","title":"駝隊出城","titleEn":"Camels Leaving Town","host":"driver","roles":{"driver":{"fig":"camel_driver","name":"趕駝的","nameEn":"camel driver","carriedBy":null},"roofman":{"fig":"roof_man_white_6290","name":"閒人","nameEn":"onlooker","carriedBy":null},"roofwatch":{"fig":"roof_watcher_5712","name":"閒人","nameEn":"onlooker","carriedBy":null}},"beats":[{"who":"driver","text":"讓讓，駱駝要出城了。","en":"Make way, the camels are heading out.","think":false,"optional":false,"as":{"guan":"官人借過，駱駝性子慢。","fu":"娘子莫怕，牠不咬人。","tong":"小娃兒，莫拽駝毛！","seng":"師父先走，駝隊慢。","jun":"軍爺，可要查貨？"},"asEn":{"guan":"By your leave, sir. Camels are slow.","fu":"Don't be afraid, madam. It doesn't bite.","tong":"Kid, don't pull the camel's hair!","seng":"After you, Master. The caravan is slow.","jun":"Soldier, will you check the goods?"}},{"who":"driver","text":"慢些，門洞窄。","en":"Easy, the passage is narrow.","think":false,"optional":false},{"who":"roofwatch","text":"好高的駱駝。","en":"What tall camels.","think":true,"optional":true},{"who":"roofman","text":"胡商又出城了。","en":"The foreign traders are leaving again.","think":false,"optional":false}],"again":[{"beats":[{"who":"driver","text":"打西北來的，做完買賣就走。","en":"We came from the northwest. Trade done, we go.","think":false,"optional":false},{"who":"roofman","text":"城門口也沒人盤查。","en":"No one at the gate even checks them.","think":false,"optional":false},{"who":"driver","text":"頭駝已出了門洞。","en":"The lead camel is already through.","think":false,"optional":false},{"who":"roofwatch","text":"前頭牽駝的，像是胡人。","en":"The one leading up front looks foreign.","think":true,"optional":false}]}],"X":-29.48,"D":3.12},{"id":"V5.5","section":"gate","title":"城下修面","titleEn":"A Shave by the Wall","host":"barber","roles":{"barber":{"fig":"barber_7805","name":"待詔","nameEn":"barber","carriedBy":null},"customer":{"fig":"wall_recliner","name":"客人","nameEn":"customer","carriedBy":null}},"beats":[{"who":"barber","text":"客官，修個面？","en":"A shave, sir?","think":false,"optional":false,"as":{"guan":"官人，修個面？刀快手穩。","shi":"相公，修個面好見人。","seng":"師父的頭，也剃一剃？","fu":"娘子稍待，這位就好。","tong":"小哥兒，剃個頭？","jun":"軍爺，修修鬍子？"},"asEn":{"guan":"A shave, sir? Sharp blade, steady hand.","shi":"A shave, sir, to look your best?","seng":"Master, a shave for your head too?","fu":"One moment, madam. He's nearly done.","tong":"Little one, a haircut?","jun":"Soldier, trim the beard?"}},{"who":"barber","text":"抬頭，莫動，這刀快。","en":"Chin up. Don't move. This razor's sharp.","think":false,"optional":false},{"who":"customer","text":"舒坦……","en":"Bliss…","think":true,"optional":false}],"again":[{"beats":[{"who":"barber","text":"又來了？這位還沒修完。","en":"Back again? This one isn't done yet.","think":false,"optional":false},{"who":"customer","text":"莫說話，刀在喉下……","en":"Don't talk. The blade's at my throat…","think":true,"optional":false},{"who":"barber","text":"城下風涼，修面最好。","en":"Cool by the wall. Best place for a shave.","think":false,"optional":false}]},{"beats":[{"who":"barber","text":"剃剪的，瓦子裏也有。","en":"There are barbers in the pleasure grounds too.","think":false,"optional":false},{"who":"customer","text":"還是城門口便當。","en":"The gate is handier.","think":false,"optional":false},{"who":"barber","text":"進城出城，順路修一修。","en":"In or out of town, a shave on the way.","think":false,"optional":false}]}],"X":-12.01,"D":8.540000000000001},{"id":"V5.6","section":"gate","title":"城下閒人","titleEn":"Idlers at the Gate","host":"white","roles":{"white":{"fig":"wall_idler_white","name":"閒人","nameEn":"idler","carriedBy":null},"blue":{"fig":"wall_idler_blue","name":"閒人","nameEn":"idler","carriedBy":null},"stick":{"fig":"wall_idler_stick","name":"閒人","nameEn":"idler","carriedBy":null},"grey":{"fig":"wall_idler_grey","name":"閒人","nameEn":"idler","carriedBy":null},"front":{"fig":"idler_front_7650","name":"閒人","nameEn":"idler","carriedBy":null},"greyfront":{"fig":"idler_grey_front_7702","name":"閒人","nameEn":"idler","carriedBy":null},"camelw":{"fig":"camel_watcher_7600","name":"閒人","nameEn":"idler","carriedBy":null}},"beats":[{"who":"white","text":"哪裏來的？","en":"Where are you from?","think":false,"optional":false,"as":{"guan":"官人出城？門上今日沒人守。","shi":"相公也來看春景？","seng":"師父往哪座寺去？","fu":"娘子出城上墳？","tong":"誰家的娃兒，跑丟了？","jun":"軍爺來得巧，這門正缺人守。","li":"兄弟，挑的甚麼？"},"asEn":{"guan":"Going out, sir? No one minds the gate today.","shi":"Out to see the spring too, sir?","seng":"Which temple are you bound for, Master?","fu":"Madam, going out to the graves?","tong":"Whose child are you? Lost?","jun":"Just in time, soldier. This gate needs a guard.","li":"Brother, what are you carrying?"}},{"who":"blue","text":"這城門也沒個看守的。","en":"Not even a guard on this gate.","think":false,"optional":false},{"who":"stick","text":"太平年月，守它作甚。","en":"Peaceful times. Why guard it?","think":false,"optional":false},{"who":"camelw","text":"看，駱駝出來了。","en":"Look, the camels are coming out.","think":false,"optional":false}],"again":[{"beats":[{"who":"grey","text":"稅務所裏又吵起來了。","en":"The tax office is quarrelling again.","think":false,"optional":false},{"who":"white","text":"匹帛稅重，哪回不吵？","en":"Cloth pays heavy. When don't they quarrel?","think":false,"optional":false},{"who":"blue","text":"連城樓上都探頭看了。","en":"Even the man on the tower is looking down.","think":false,"optional":false},{"who":"front","text":"進城頭一家，就是收稅的。","en":"The first house inside the gate takes tax.","think":false,"optional":false}],"step":"tax.2"},{"beats":[{"who":"stick","text":"那戴帷帽的，是誰家的？","en":"Whose is that one in the veiled hat?","think":false,"optional":false},{"who":"greyfront","text":"看不清臉，許是哪家娘子。","en":"Can't see the face. Some lady, perhaps.","think":false,"optional":false},{"who":"blue","text":"那跪著的，在祭路神。","en":"The kneeling one is praying to the road god.","think":false,"optional":false},{"who":"white","text":"出門在外，求個平安。","en":"Away from home, you pray for safety.","think":false,"optional":false}]}],"X":-10.87,"D":5.99},{"id":"V5.8","section":"gate","title":"帷帽出城","titleEn":"The Veiled Rider","host":"groom","roles":{"groom":{"fig":"groom_8167","name":"馬夫","nameEn":"groom","carriedBy":null},"rider":{"fig":"rider_8080","name":"帷帽客","nameEn":"veiled rider","carriedBy":null},"servant":{"fig":"luggage_servant_8002","name":"僕人","nameEn":"servant","carriedBy":null}},"beats":[{"who":"groom","text":"借過，驢子過來了。","en":"Coming through. Donkey passing.","think":false,"optional":false,"as":{"guan":"官人請先，小的牽穩了。","fu":"娘子先請。","seng":"師父借過。","tong":"小娃兒閃開，驢要踢人！"},"asEn":{"guan":"After you, sir. I have him steady.","fu":"After you, madam.","seng":"Excuse us, Master.","tong":"Kid, move! The donkey kicks!"}},{"who":"groom","text":"坐穩了，前頭過橋。","en":"Hold on. There's a bridge ahead.","think":false,"optional":false},{"who":"servant","text":"行李都在，一件不少。","en":"All the luggage is here, not a piece missing.","think":false,"optional":false},{"who":"rider","text":"這帷帽，擋得住風塵。","en":"This veil keeps off the wind and dust.","think":true,"optional":false}],"again":[{"beats":[{"who":"groom","text":"這一程，要走到天黑。","en":"This stretch takes us till dark.","think":false,"optional":false},{"who":"servant","text":"包袱沉，肩都壓紅了。","en":"The bundle's heavy. My shoulder's red.","think":false,"optional":false},{"who":"rider","text":"到了前頭，歇一歇腳。","en":"Up ahead we'll rest a while.","think":false,"optional":false}]}],"X":-4.05,"D":6.24},{"id":"V5.9","section":"gate","title":"書屏遭廢","titleEn":"The Banned Screen","host":"pusher","roles":{"pusher":{"fig":"cart_pusher_8254","name":"車夫","nameEn":"carter","carriedBy":null},"shaft":{"fig":"cart_shaftman_8498","name":"車夫","nameEn":"carter","carriedBy":null},"rider":{"fig":"trace_donkey_rider_8740","name":"趕驢的","nameEn":"donkey driver","carriedBy":null},"bend":{"fig":"bending_man_8905","name":"牽驢的","nameEn":"donkey leader","carriedBy":null}},"beats":[{"who":"pusher","text":"讓讓，車重！","en":"Make way, heavy load!","think":false,"optional":false,"as":{"guan":"官人讓一讓，車重收不住。","shi":"相公莫看，快讓開。","seng":"師父借過，車要上橋。","fu":"娘子靠邊，莫碰著。","tong":"小娃兒，閃開！"},"asEn":{"guan":"Step aside, sir. The cart is too heavy to stop.","shi":"Don't look, sir. Out of the way.","seng":"Excuse us, Master. The cart's going onto the bridge.","fu":"Madam, stand aside. Don't get hit.","tong":"Kid, get clear!"}},{"who":"shaft","text":"慢！輪子卡住了。","en":"Hold it! The wheel's stuck.","think":false,"optional":false},{"who":"pusher","text":"使勁！上橋了！","en":"Heave! Onto the bridge!","think":false,"optional":false},{"who":"rider","text":"驢也拉不動了。","en":"Even the donkey can't pull it.","think":false,"optional":false},{"who":"push